---
// Página inicial: chamada + abas de tópicos + feed em mosaico com todos os posts.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CardPost from '../components/CardPost.astro';
import { categorias } from '../lib/rotulos';
import { formatoDoCard, corDoCard } from '../lib/feed';

const posts = (await getCollection('posts')).sort((a, b) => b.data.data.getTime() - a.data.data.getTime());
---

<Base>
  <section class="container hero">
    <div class="hero-texto">
      <p class="sobrancelha">do wpp pro blog</p>
      <h1><span>É isso mesmo,</span> a gente julga tudo.</h1>
      <p class="hero-sub">
        Tudo que a gente já comentava só entre a gente, agora aberto pra todo mundo.
        Porque todo mundo merece saber o que presta (e o que não presta).
      </p>
      <a href="#feed" class="botao">ver posts ↓</a>
    </div>

    <div class="chat" aria-hidden="true">
      <p class="balao delas">ouuu, vc já comeu aquele doce que tá todo mundo postando no tiktok?</p>
      <p class="balao nosso">mano sim... achei horrivel</p>
      <p class="balao delas">SERIO?</p>
      <p class="balao nosso">ai sim KKKKKKK nota 2</p>
      <p class="balao delas digitando"><i></i><i></i><i></i></p>
    </div>
  </section>

  <div id="feed" class="abas-faixa">
    <div class="container">
      <div class="abas-linha">
        <nav class="abas" aria-label="Filtrar posts por tópico">
          <button type="button" data-topico="" aria-pressed="true">Tudo</button>
          {categorias.map((c) => (
            <button type="button" data-topico={c.value} aria-pressed="false">{c.label}</button>
          ))}
        </nav>
        <button type="button" class="botao-legenda" data-abrir-legenda>
          <span class="texto-legenda">O que é cada nota?</span>
          <span class="interrogacao" aria-hidden="true">?</span>
        </button>
      </div>
    </div>
  </div>

  <section class="container feed">
    <div class="mosaico" id="mosaico">
      {posts.map((post, i) => <CardPost post={post} formato={formatoDoCard(i)} cor={corDoCard(i)} />)}
    </div>
    <p class="vazio" id="vazio" hidden={posts.length > 0}>nada aqui ainda... sugestão?</p>
  </section>
</Base>

<script>
  // Abas: mostra só os posts do tópico escolhido, reorganiza o mosaico
  // e guarda a escolha no link (?topico=...).
  import { formatoDoCard, corDoCard } from '../lib/feed';

  const botoes = document.querySelectorAll<HTMLButtonElement>('[data-topico]');
  const cards = document.querySelectorAll<HTMLElement>('#mosaico > [data-categoria]');
  const vazio = document.getElementById('vazio')!;
  const feed = document.getElementById('feed')!;

  function filtrar(topico: string, atualizarLink = true) {
    let posicao = 0;
    cards.forEach((card) => {
      const aparece = !topico || card.dataset.categoria === topico;
      card.hidden = !aparece;
      if (aparece) {
        card.dataset.formato = formatoDoCard(posicao);
        card.dataset.cor = corDoCard(posicao);
        posicao++;
      }
    });
    vazio.hidden = posicao > 0;
    botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topico === topico)));

    if (atualizarLink) {
      const url = new URL(location.href);
      if (topico) url.searchParams.set('topico', topico);
      else url.searchParams.delete('topico');
      history.replaceState(null, '', url);
    }
  }

  botoes.forEach((b) =>
    b.addEventListener('click', () => {
      const abasGrudadas = feed.getBoundingClientRect().top <= 68;
      filtrar(b.dataset.topico ?? '');
      // Se a pessoa já estava rolando o feed, mantém o começo do feed na tela.
      if (abasGrudadas) feed.scrollIntoView({ block: 'start' });
    })
  );

  const inicial = new URLSearchParams(location.search).get('topico');
  if (inicial) filtrar(inicial, false);
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 56px;
    align-items: center;
    padding-top: 56px;
    padding-bottom: 72px;
  }
  .hero h1 { font-size: clamp(2.8rem, 6.5vw, 5rem); font-weight: 800; margin: 14px 0 20px; }
  .hero h1 span { color: var(--azul-cinza); }
  .hero-sub { font-size: 1.15rem; color: var(--texto-suave); max-width: 32em; margin: 0 0 28px; }

  /* Conversinha no chat, com os balões aparecendo um por um. */
  .chat {
    background: var(--branco);
    border-radius: 28px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 20px 50px rgb(20 33 61 / 0.08);
  }
  .balao {
    margin: 0;
    max-width: 80%;
    padding: 10px 16px;
    border-radius: 20px;
    font-size: 1rem;
    line-height: 1.35;
    animation: aparecer 0.4s ease-out both;
  }
  .delas { align-self: flex-start; background: var(--cinza-claro); border-bottom-left-radius: 6px; }
  .nosso { align-self: flex-end; background: var(--marinho); color: var(--branco); border-bottom-right-radius: 6px; }
  .balao:nth-child(2) { animation-delay: 0.6s; }
  .balao:nth-child(3) { animation-delay: 1.2s; }
  .balao:nth-child(4) { animation-delay: 1.8s; }
  .balao:nth-child(5) { animation-delay: 2.4s; }
  .digitando { display: flex; gap: 5px; padding: 14px 16px; }
  .digitando i { width: 8px; height: 8px; border-radius: 50%; background: var(--cinza); animation: pulinho 1.2s infinite; }
  .digitando i:nth-child(2) { animation-delay: 0.15s; }
  .digitando i:nth-child(3) { animation-delay: 0.3s; }

  @keyframes aparecer { from { opacity: 0; transform: translateY(8px) scale(0.96); } }
  @keyframes pulinho { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-5px); } }
  @media (prefers-reduced-motion: reduce) { .balao, .digitando i { animation: none; } }

  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; padding-top: 32px; gap: 36px; }
  }

  /* Abas de tópicos: faixa entre duas linhas, em caixa alta. Grudam no topo ao rolar. */
  .abas-faixa {
    position: sticky;
    top: 68px;
    z-index: 10;
    background: var(--fundo);
    scroll-margin-top: 68px;
  }
  .abas-linha {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1.5px solid var(--marinho);
    border-bottom: 1.5px solid var(--marinho);
    padding: 12px 0;
  }
  .abas {
    flex: 1;
    min-width: 0;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .abas::-webkit-scrollbar { display: none; }
  .abas button, .botao-legenda {
    flex: none;
    font: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marinho);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .abas button:hover { background: var(--cinza-claro); }
  .abas button[aria-pressed='true'] { background: var(--marinho); color: var(--branco); }

  /* Botão da legenda das notas, no fim da faixa. */
  .botao-legenda {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--azul-cinza);
    padding-right: 6px;
  }
  .botao-legenda:hover { color: var(--marinho); }
  .interrogacao {
    width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center;
    border: 1.5px solid currentColor;
    font-size: 0.8rem;
  }
  @media (max-width: 800px) { .texto-legenda { display: none; } }

  .feed { padding-top: 24px; }
  .vazio { text-align: center; color: var(--texto-suave); font-size: 1.1rem; padding: 60px 0; margin: 0; }
</style>
