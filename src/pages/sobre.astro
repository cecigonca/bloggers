---
// Página "Sobre nós". O conteúdo é editado pelo admin (/keystatic → Sobre nós)
// e fica salvo em src/data/sobre.yaml.
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Base from '../layouts/Base.astro';
import Veredito from '../components/Veredito.astro';
import { notas } from '../lib/rotulos';

const reader = createReader(process.cwd(), keystaticConfig);
const sobre = await reader.singletons.sobre.read();

const chamada = sobre?.chamada || 'Basicamente duas amigas com opinião sobre tudo';
const paragrafos = (sobre?.texto ?? '').split(/\n\s*\n/).filter(Boolean);
const pessoas = sobre?.pessoas ?? [];
---

<Base titulo="Sobre nós">
  <section class="container-estreito intro">
    <p class="sobrancelha">sobre nós</p>
    <h1>{chamada}</h1>
    {paragrafos.map((p) => <p class="texto">{p}</p>)}
  </section>

  {pessoas.length > 0 && (
    <section class="container pessoas">
      {pessoas.map((pessoa, i) => (
        <div class:list={['pessoa', `pessoa-${i % 2}`]}>
          {pessoa.foto ? (
            <img src={pessoa.foto} alt={pessoa.nome} class="foto" />
          ) : (
            <span class="foto foto-inicial" aria-hidden="true">{pessoa.nome.charAt(0)}</span>
          )}
          <h2>{pessoa.nome}</h2>
          <p>{pessoa.bio}</p>
        </div>
      ))}
    </section>
  )}

  <section class="container-estreito escala">
    <h2>Como a gente avalia</h2>
    <p class="texto">Nada de estrelinha. Cada post termina com um veredito, e ele é final (até a gente mudar de ideia).</p>
    <ul>
      {notas.map((n) => (
        <li>
          <Veredito nota={Number(n.value)} />
          <span>{n.descricao}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro { padding-top: 56px; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); font-weight: 800; margin: 14px 0 24px; }
  .texto { font-size: 1.15rem; color: var(--texto-suave); margin: 0 0 1em; }

  .pessoas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    max-width: 880px;
    margin-top: 48px;
  }
  .pessoa { background: var(--branco); border-radius: var(--raio); padding: 28px; }
  .foto { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; }
  .foto-inicial {
    display: grid; place-items: center;
    background: var(--marinho); color: var(--branco);
    font-family: var(--fonte-titulo); font-weight: 800; font-size: 2.6rem;
  }
  .pessoa-1 .foto-inicial { background: var(--azul-cinza); }
  .pessoa h2 { font-size: 1.8rem; margin: 18px 0 8px; }
  .pessoa p { margin: 0; color: var(--texto-suave); }

  .escala { margin-top: 80px; }
  .escala h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 12px; }
  .escala ul { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-direction: column; gap: 18px; }
  .escala li { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .escala li :global(.selo) { min-width: 170px; text-align: center; }
</style>
