---
// Página "Sobre nós". O conteúdo é editado pelo admin (/keystatic → Sobre nós)
// e fica salvo em src/data/sobre.yaml. A parte "Como a gente avalia" é fixa.
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Base from '../layouts/Base.astro';
import Estrela from '../components/Estrela.astro';
import { notas } from '../lib/rotulos';

const reader = createReader(process.cwd(), keystaticConfig);
const sobre = await reader.singletons.sobre.read();

const chamada = sobre?.chamada || 'Basicamente duas amigas com opinião sobre tudo';
const paragrafos = (sobre?.texto ?? '').split(/\n\s*\n/).filter(Boolean);
const pessoas = sobre?.pessoas ?? [];
const escala = [...notas].sort((a, b) => Number(a.value) - Number(b.value));
---

<Base titulo="Sobre nós">
  <div class="coluna">
    <section class="intro">
      <p class="sobrancelha">sobre nós</p>
      <h1>{chamada}</h1>
      {paragrafos.map((p) => <p class="texto">{p}</p>)}
    </section>

    {pessoas.length > 0 && (
      <section class="bloco-secao">
        <h2>Quem somos</h2>
        <div class="pessoas">
          {pessoas.map((pessoa, i) => (
            <article class:list={['pessoa', `pessoa-${i % 2}`]}>
              <div class="pessoa-topo">
                {pessoa.foto ? (
                  <img src={pessoa.foto} alt={pessoa.nome} class="foto" />
                ) : (
                  <span class="foto foto-inicial" aria-hidden="true">{pessoa.nome.charAt(0)}</span>
                )}
                <div>
                  <h3>{pessoa.nome}</h3>
                  {pessoa.frase && <p class="frase">{pessoa.frase}</p>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="bloco-secao">
      <h2>Como a gente avalia</h2>
      <p class="texto">As notas vão de 1 a 5.</p>

      <ol class="regua">
        {escala.map((n) => (
          <li class={`degrau nota-${n.value}`}>
            <span class="barra" aria-hidden="true"></span>
            <span class="numero">{n.value}<Estrela /></span>
            <strong>{n.label.toLowerCase()}</strong>
            <span class="descricao">{n.descricao}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<style>
  .coluna { max-width: 880px; margin: 0 auto; padding: 0 16px; }

  .intro { padding-top: 48px; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); font-weight: 800; margin: 14px 0 24px; }
  .texto { font-size: 1.15rem; line-height: 1.65; color: var(--texto-suave); margin: 0 0 1em; max-width: 60ch; }

  .bloco-secao { margin-top: 72px; }
  .bloco-secao > h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 20px; }

  /* Quem somos */
  .pessoas { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .pessoa { background: var(--branco); border-radius: var(--raio); padding: 28px; }
  .pessoa-topo { display: flex; align-items: center; gap: 18px; }
  .foto { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; flex: none; }
  .foto-inicial {
    display: grid; place-items: center;
    background: var(--marinho); color: var(--branco);
    font-family: var(--fonte-titulo); font-weight: 800; font-size: 2.2rem;
  }
  .pessoa-1 .foto-inicial { background: var(--azul-cinza); }
  .pessoa h3 { font-size: 2rem; font-weight: 800; }
  .frase { margin: 4px 0 0; color: var(--texto-suave); font-size: 1.05rem; }


  /* Régua das notas */
  .regua {
    list-style: none; padding: 28px; margin: 20px 0 0;
    background: var(--branco); border-radius: var(--raio);
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px;
  }
  .degrau { display: flex; flex-direction: column; gap: 8px; }
  .barra { height: 10px; border-radius: 999px; background: var(--cor-degrau); }
  .nota-1 { --cor-degrau: var(--cinza-claro); }
  .nota-2 { --cor-degrau: var(--azul-cinza-claro); }
  .nota-3 { --cor-degrau: var(--azul-cinza); }
  .nota-4 { --cor-degrau: var(--marinho-claro); }
  .nota-5 { --cor-degrau: var(--dourado); }
  .numero {
    display: flex; align-items: center; gap: 4px; margin-top: 6px;
    font-family: var(--fonte-titulo); font-weight: 800; font-size: 3.2rem; line-height: 1; letter-spacing: -0.04em;
  }
  .numero :global(.estrela) { width: 0.5em; height: 0.5em; }
  .nota-5 .numero { color: var(--dourado); }
  .degrau strong { font-size: 1.05rem; }
  .descricao { font-size: 0.92rem; line-height: 1.35; color: var(--texto-suave); padding-right: 6px; }

  @media (max-width: 700px) {
    .regua { grid-template-columns: 1fr; gap: 14px; padding: 22px; }
    .degrau { display: grid; grid-template-columns: 6px 64px 1fr; grid-template-rows: auto auto; column-gap: 14px; align-items: center; }
    .barra { grid-row: span 2; height: 100%; width: 6px; }
    .numero { grid-row: span 2; margin: 0; font-size: 2.4rem; }
    .degrau strong { align-self: end; }
    .descricao { align-self: start; }
    .pessoa { padding: 22px; }
  }
</style>
