---
// Página de um post. Tudo numa coluna só: título, foto, blocos, ficha, texto, galeria e veredito.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Veredito from '../../components/Veredito.astro';
import Estrela from '../../components/Estrela.astro';
import CardPost from '../../components/CardPost.astro';
import Logo from '../../components/Logo.astro';
import { categorias, rotulo, veredito, dataLonga } from '../../lib/rotulos';
import { lerOpiniao } from '../../lib/opiniao';
import { corDoCard } from '../../lib/feed';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, todos: posts } }));
}

const { post, todos } = Astro.props;
const { titulo, resumo, capa, categoria, tambemEm, spoiler, positivo, negativo, ficha, resumindo, data, tags, esconderData, esconderAutoria } = post.data;
const galeria = post.data.galeria.filter((g) => g.foto);
const opiniao = lerOpiniao(post.data.opiniao);
const temTexto = Boolean(post.body?.trim());
const { Content } = await render(post);

// Todas as abas do post: a principal primeiro, depois as outras.
const categoriasDoPost = [categoria, ...tambemEm.filter((c) => c !== categoria)];
const emComum = (p: (typeof todos)[number]) =>
  [p.data.categoria, ...p.data.tambemEm].filter((c) => categoriasDoPost.includes(c)).length;

// "Leia também": primeiro os que dividem alguma aba com este post, depois os mais recentes.
const relacionados = todos
  .filter((p) => p.id !== post.id)
  .sort((a, b) => emComum(b) - emComum(a) || b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Base titulo={titulo} descricao={resumo}>
  <article>
    <header class="coluna topo-post">
      <a href="/#feed" class="voltar" id="voltar">← voltar pro feed</a>
      <div class="chips">
        {categoriasDoPost.map((c) => (
          <a href={`/?topico=${c}#feed`} class="chip">{rotulo(categorias, c)}</a>
        ))}
      </div>
      <h1>{titulo}</h1>
      {resumo && <p class="lead">{resumo}</p>}

      <div class:list={['meta', { 'so-nota': esconderAutoria && esconderData }]}>
        {!esconderAutoria && (opiniao.divididas ? (
          <span class="avatares" aria-hidden="true">
            {opiniao.votos.map((v, i) => <span class:list={['avatar', `avatar-${i}`]}>{v.nome.charAt(0)}</span>)}
          </span>
        ) : (
          <span class="avatar" aria-hidden="true">{opiniao.quem === 'chatinhas' ? <Logo /> : opiniao.nome.charAt(0)}</span>
        ))}
        {(!esconderAutoria || !esconderData) && (
          <span>
            {!esconderAutoria && <>por <strong>{opiniao.nome}</strong></>}
            {!esconderAutoria && !esconderData && <br />}
            {!esconderData && <span class="data">{dataLonga(data)}</span>}
          </span>
        )}
        <button type="button" class="meta-selo" data-abrir-legenda title="O que é cada nota?">
          {opiniao.divididas
            ? opiniao.votos.map((v) => <Veredito nota={v.nota} quem={v.nome} />)
            : <Veredito nota={opiniao.nota} />}
          <span class="interrogacao" aria-hidden="true">?</span>
        </button>
      </div>

      {spoiler && (
        <p class="aviso-spoiler"><span class="aviso-rotulo">spoiler</span> esse post conta o final. se ainda não viu, volta depois.</p>
      )}
    </header>

    {capa && <div class="coluna"><img src={capa} alt="" class="capa" /></div>}

    <div class="coluna secoes">
      {(positivo.length > 0 || negativo.length > 0) && (
        <section class="blocos">
          {positivo.length > 0 && (
            <div class="bloco">
              <h2><span class="marca marca-sim" aria-hidden="true">+</span> Positivo</h2>
              <ul>{positivo.map((item) => <li>{item}</li>)}</ul>
            </div>
          )}
          {negativo.length > 0 && (
            <div class="bloco">
              <h2><span class="marca marca-nao" aria-hidden="true">−</span> Negativo</h2>
              <ul>{negativo.map((item) => <li>{item}</li>)}</ul>
            </div>
          )}
        </section>
      )}

      {ficha.length > 0 && (
        <section class="ficha" aria-label="Ficha rápida">
          {ficha.map((f) => (
            <div class="ficha-item">
              <span class="ficha-rotulo">{f.rotulo}</span>
              <span class="ficha-valor">{f.valor}</span>
            </div>
          ))}
        </section>
      )}

      {temTexto && (
        <div class="prosa">
          <Content />
        </div>
      )}

      {galeria.length > 0 && (
        <section class:list={['galeria', `galeria-${Math.min(galeria.length, 3)}`]} aria-label="Galeria de fotos">
          {galeria.map((g) => (
            <figure>
              <img src={g.foto!} alt={g.legenda} loading="lazy" />
              {g.legenda && <figcaption>{g.legenda}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      {opiniao.divididas ? (
        <section class="veredito">
          <p class="sobrancelha">veredito final</p>
          <div class="placar">
            {opiniao.votos.map((v, i) => (
              <div class:list={['lado', `lado-${i}`]}>
                <div class="lado-topo">
                  <span class="avatar" aria-hidden="true">{v.nome.charAt(0)}</span>
                  <strong>{v.nome}</strong>
                </div>
                <div class="lado-nota">
                  <p class="nota-media" aria-label={`Nota ${v.nota} de 5`}>{v.nota}<span class:list={[{ ouro: v.nota === 5 }]}><Estrela /></span></p>
                  <p class="veredito-nome veredito-nome-menor">{veredito(v.nota).label}</p>
                </div>
                {v.texto && <p class="lado-texto">{v.texto}</p>}
              </div>
            ))}
          </div>
          {resumindo && <p class="resumindo resumindo-final"><strong>resumindo:</strong> {resumindo}</p>}
        </section>
      ) : (
        <section class="veredito">
          <p class="sobrancelha">veredito final</p>
          <div class="veredito-linha">
            <p class="nota-grande" aria-label={`Nota ${opiniao.nota} de 5`}>{opiniao.nota}<span class:list={[{ ouro: opiniao.nota === 5 }]}><Estrela /></span></p>
            <div>
              <p class="veredito-nome">{veredito(opiniao.nota).label}</p>
              <p class="resumindo">{resumindo || veredito(opiniao.nota).descricao}</p>
            </div>
          </div>
        </section>
      )}

      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => <li>#{tag}</li>)}
        </ul>
      )}
    </div>
  </article>

  {relacionados.length > 0 && (
    <section class="container mais">
      <h2>Leia também</h2>
      <div class="trio">
        {relacionados.map((p, i) => <CardPost post={p} cor={corDoCard(i + 1)} />)}
      </div>
    </section>
  )}
</Base>

<script>
  // "Voltar pro feed" volta pra mesma aba em que a pessoa estava (ex.: Trending).
  const voltar = document.getElementById('voltar') as HTMLAnchorElement | null;
  try {
    const anterior = new URL(document.referrer);
    if (voltar && anterior.origin === location.origin && anterior.pathname === '/') {
      voltar.href = `/${anterior.search}#feed`;
    }
  } catch {
    // Sem página anterior do próprio blog: fica o link padrão.
  }
</script>

<style>
  /* Uma coluna só: tudo com as mesmas bordas. */
  .coluna { max-width: 880px; margin: 0 auto; padding: 0 16px; }

  .topo-post { padding-top: 32px; }
  .voltar { display: inline-block; margin-bottom: 24px; font-weight: 600; color: var(--azul-cinza); text-decoration: none; }
  .voltar:hover { color: var(--marinho); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-block;
    font-size: 0.9rem; font-weight: 600; text-transform: lowercase;
    text-decoration: none; color: var(--marinho);
    border: 1.5px solid var(--marinho); border-radius: 999px; padding: 5px 14px;
    transition: background 0.15s, color 0.15s;
  }
  .chip:hover { background: var(--marinho); color: var(--branco); }
  h1 { font-size: clamp(2.3rem, 6vw, 3.8rem); font-weight: 800; margin: 20px 0 16px; }
  .lead { font-size: 1.3rem; line-height: 1.45; color: var(--texto-suave); margin: 0 0 28px; max-width: 34em; }

  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; line-height: 1.3; }
  .avatar {
    width: 44px; height: 44px; border-radius: 50%; flex: none;
    display: grid; place-items: center;
    background: var(--azul-cinza-claro); color: var(--marinho);
    font-family: var(--fonte-titulo); font-weight: 800; font-size: 1.2rem;
  }
  .avatar :global(svg) { width: 24px; height: 24px; }
  .avatares { display: flex; }
  .avatares .avatar-1 { margin-left: -12px; background: var(--azul-cinza); color: var(--branco); box-shadow: 0 0 0 3px var(--fundo); }
  .data { font-size: 0.9rem; color: var(--cinza); }
  .meta-selo {
    margin-left: auto; display: inline-flex; align-items: center; gap: 6px;
    font: inherit; background: none; border: 0; padding: 0; cursor: pointer; color: var(--azul-cinza);
  }
  .meta-selo:hover { color: var(--marinho); }
  .so-nota .meta-selo { margin-left: 0; }
  .interrogacao {
    width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center;
    border: 1.5px solid currentColor; font-size: 0.75rem; font-weight: 700;
  }

  .aviso-spoiler {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    margin: 24px 0 0; padding: 12px 16px;
    border-radius: 14px; background: var(--cinza-claro); color: var(--marinho); font-size: 0.98rem;
  }
  .aviso-rotulo {
    font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    background: var(--marinho); color: var(--branco); padding: 4px 10px; border-radius: 999px;
  }

  .capa { width: 100%; margin-top: 32px; border-radius: var(--raio); max-height: 520px; object-fit: cover; }

  .secoes { display: flex; flex-direction: column; gap: 20px; padding-top: 32px; }

  /* Positivo / negativo: dois blocos com o mesmo peso. */
  .blocos { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .bloco { background: var(--branco); border-radius: var(--raio); padding: 24px 26px; }
  .bloco h2 { font-size: 1.35rem; display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .marca {
    width: 30px; height: 30px; border-radius: 50%; flex: none;
    display: grid; place-items: center;
    font-family: var(--fonte-texto); font-size: 1.25rem; font-weight: 700; line-height: 1;
  }
  .marca-sim { background: var(--marinho); color: var(--branco); }
  .marca-nao { background: var(--branco); color: var(--marinho); box-shadow: inset 0 0 0 2px var(--marinho); }
  .bloco ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .bloco li { padding-left: 40px; position: relative; line-height: 1.4; }
  .bloco li::before {
    content: ''; position: absolute; left: 12px; top: 0.55em;
    width: 6px; height: 6px; border-radius: 50%; background: var(--azul-cinza-claro);
  }

  /* Ficha rápida: faixa entre duas linhas, sem fundo (bem diferente dos blocos). */
  .ficha {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-top: 1.5px solid var(--marinho); border-bottom: 1.5px solid var(--marinho);
    padding: 14px 0;
  }
  .ficha-item { padding: 2px 20px; display: flex; flex-direction: column; gap: 2px; border-left: 1px solid var(--azul-cinza-claro); }
  .ficha-item:first-child { border-left: 0; padding-left: 0; }
  .ficha-rotulo { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--azul-cinza); }
  .ficha-valor { font-family: var(--fonte-titulo); font-weight: 700; font-size: 1.15rem; }

  /* Texto livre */
  .prosa { font-size: 1.12rem; line-height: 1.75; max-width: 68ch; }
  .prosa :global(h2) { font-size: 1.9rem; margin: 1.6em 0 0.5em; }
  .prosa :global(h3) { font-size: 1.4rem; margin: 1.4em 0 0.4em; }
  .prosa :global(p) { margin: 0 0 1.1em; }
  .prosa :global(a) { text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .prosa :global(strong) { font-weight: 700; }
  .prosa :global(ul), .prosa :global(ol) { padding-left: 1.3em; margin: 0 0 1.1em; }
  .prosa :global(li) { margin-bottom: 0.3em; }
  .prosa :global(li::marker) { color: var(--azul-cinza); }
  .prosa :global(blockquote) {
    margin: 32px 0; padding: 0 0 0 20px;
    border-left: 4px solid var(--marinho);
    font-family: var(--fonte-titulo); font-size: 1.5rem; line-height: 1.3; font-weight: 600;
  }
  .prosa :global(blockquote p) { margin: 0; }
  .prosa :global(hr) { border: 0; border-top: 1.5px dashed var(--azul-cinza-claro); margin: 40px 0; }

  /* Galeria: a primeira foto maior. */
  .galeria { display: grid; gap: 12px; }
  .galeria figure { margin: 0; display: flex; flex-direction: column; }
  .galeria img { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; flex: 1; min-height: 0; }
  .galeria figcaption { margin-top: 8px; font-size: 0.9rem; color: var(--cinza); }
  .galeria-1 img { max-height: 560px; }
  .galeria-2 { grid-template-columns: 1fr 1fr; }
  .galeria-2 img { aspect-ratio: 4 / 5; }
  .galeria-3 { grid-template-columns: 2fr 1fr; grid-auto-rows: 220px; }
  .galeria-3 figure:first-child { grid-row: span 2; }

  /* Veredito */
  .veredito { background: var(--marinho); color: var(--branco); border-radius: var(--raio); padding: 28px 32px; margin-top: 8px; }
  .veredito .sobrancelha { color: var(--azul-cinza-claro); }
  .veredito-linha { display: flex; align-items: center; gap: 24px; margin-top: 8px; }
  .nota-grande { font-family: var(--fonte-titulo); font-weight: 800; font-size: 5rem; line-height: 1; margin: 0; display: flex; align-items: center; gap: 6px; }
  .nota-grande span, .nota-media span { display: flex; color: var(--azul-cinza-claro); }
  .nota-grande span { font-size: 2.6rem; }
  .nota-grande .ouro, .nota-media .ouro { color: var(--dourado); }
  .veredito-nome { font-family: var(--fonte-titulo); font-weight: 800; font-size: 2rem; margin: 0; }
  .resumindo { margin: 4px 0 0; color: var(--azul-cinza-claro); font-size: 1.05rem; }

  /* Placar: quando cada uma acha uma coisa, as duas opiniões dividem o mesmo quadro. */
  .placar { display: grid; grid-template-columns: 1fr 1fr; margin-top: 16px; }
  .lado { display: flex; flex-direction: column; gap: 12px; padding-right: 28px; }
  .lado-1 { padding: 0 0 0 28px; border-left: 1px solid rgb(199 208 221 / 0.3); }
  .lado-topo { display: flex; align-items: center; gap: 10px; }
  .lado-topo .avatar { width: 36px; height: 36px; font-size: 1rem; }
  .lado-1 .avatar { background: var(--azul-cinza); color: var(--branco); }
  .lado-nota { display: flex; align-items: center; gap: 14px; }
  .nota-media { font-family: var(--fonte-titulo); font-weight: 800; font-size: 3.6rem; line-height: 1; margin: 0; display: flex; align-items: center; gap: 4px; }
  .nota-media span { font-size: 1.8rem; }
  .veredito-nome-menor { font-size: 1.5rem; }
  .lado-texto { margin: 0; color: var(--azul-cinza-claro); line-height: 1.5; }
  .resumindo-final {
    margin-top: 24px; padding-top: 20px;
    border-top: 1px solid rgb(199 208 221 / 0.3);
    color: var(--branco); font-size: 1.1rem;
  }

  .tags { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { background: var(--cinza-claro); border-radius: 999px; padding: 4px 14px; font-size: 0.9rem; color: var(--azul-cinza); font-weight: 600; }

  .mais { margin-top: 96px; }
  .mais h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 28px; }

  @media (max-width: 700px) {
    .ficha { grid-template-columns: 1fr 1fr; row-gap: 14px; }
    .ficha-item { border-left: 0; padding: 0; }
    .galeria-3 { grid-template-columns: 1fr 1fr; grid-auto-rows: 160px; }
    .galeria-3 figure:first-child { grid-row: auto; grid-column: span 2; }
    .galeria-3 figure:first-child img { min-height: 240px; }
    .placar { grid-template-columns: 1fr; gap: 20px; }
    .lado { padding: 0; }
    .lado-1 { padding: 20px 0 0; border-left: 0; border-top: 1px solid rgb(199 208 221 / 0.3); }
    .veredito { padding: 24px 22px; }
  }
</style>
