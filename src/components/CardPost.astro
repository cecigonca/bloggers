---
// Card de um post no feed. O tamanho (formato) e a cor vêm de src/lib/feed.ts.
import type { CollectionEntry } from 'astro:content';
import { categorias, autoras, rotulo, veredito, dataCurta } from '../lib/rotulos';
import type { Formato } from '../lib/feed';

interface Props {
  post: CollectionEntry<'posts'>;
  formato?: Formato;
  cor?: string;
}

const { post, formato = 'pequeno', cor = 'branco' } = Astro.props;
const { titulo, resumo, capa, nota, categoria, autora, data } = post.data;
---

<a
  href={`/posts/${post.id}`}
  class="card"
  data-categoria={categoria}
  data-formato={formato}
  data-cor={cor}
  data-foto={capa ? 'sim' : undefined}
>
  {capa && <img src={capa} alt="" loading="lazy" class="foto" />}

  <div class="topo-card">
    <span class="categoria">{rotulo(categorias, categoria)}</span>
    <span class="nota">{nota}/5 · {veredito(nota).label.toLowerCase()}</span>
  </div>

  {!capa && resumo && <p class="balao">{resumo}</p>}

  <div class="rodape-card">
    <h2>{titulo}</h2>
    <p class="meta">por {rotulo(autoras, autora)} · {dataCurta(data)}</p>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border-radius: var(--raio);
    overflow: hidden;
    text-decoration: none;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgb(20 33 61 / 0.12); }
  .card:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }

  /* Cores de cada card */
  [data-cor='marinho'] {
    --cor-fundo: var(--marinho); --cor-texto: var(--branco); --cor-suave: var(--azul-cinza-claro);
    --cor-balao: var(--branco); --cor-balao-texto: var(--marinho);
    --cor-nota: var(--branco); --cor-nota-texto: var(--marinho);
  }
  [data-cor='claro'] {
    --cor-fundo: var(--azul-cinza-claro); --cor-texto: var(--marinho); --cor-suave: var(--azul-cinza);
    --cor-balao: var(--marinho); --cor-balao-texto: var(--branco);
    --cor-nota: var(--marinho); --cor-nota-texto: var(--branco);
  }
  [data-cor='branco'] {
    --cor-fundo: var(--branco); --cor-texto: var(--marinho); --cor-suave: var(--cinza);
    --cor-balao: var(--cinza-claro); --cor-balao-texto: var(--marinho);
    --cor-nota: var(--marinho); --cor-nota-texto: var(--branco);
  }
  [data-cor='azul'] {
    --cor-fundo: var(--azul-cinza); --cor-texto: var(--branco); --cor-suave: var(--cinza-claro);
    --cor-balao: var(--branco); --cor-balao-texto: var(--marinho);
    --cor-nota: var(--marinho); --cor-nota-texto: var(--branco);
  }
  /* Com foto: a foto ocupa o card todo e o texto fica branco por cima. */
  [data-foto] {
    --cor-texto: var(--branco); --cor-suave: var(--cinza-claro);
    --cor-nota: var(--branco); --cor-nota-texto: var(--marinho);
  }

  .foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  [data-foto]::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgb(20 33 61 / 0.88), rgb(20 33 61 / 0.1) 65%);
  }
  .card:hover .foto { transform: scale(1.04); }
  .topo-card, .balao, .rodape-card { position: relative; z-index: 1; }

  .topo-card { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .categoria { font-size: 0.85rem; font-weight: 600; color: var(--cor-suave); text-transform: lowercase; }
  .nota {
    font-size: 0.78rem; font-weight: 700; white-space: nowrap;
    background: var(--cor-nota); color: var(--cor-nota-texto);
    padding: 4px 10px; border-radius: 999px;
  }

  /* A "fofoca em uma frase" vira um balão de chat. */
  .balao {
    align-self: flex-start;
    margin: auto 0;
    max-width: 92%;
    background: var(--cor-balao);
    color: var(--cor-balao-texto);
    padding: 12px 16px;
    border-radius: 20px 20px 20px 6px;
    font-size: 1.02rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .rodape-card { margin-top: auto; }
  h2 {
    font-size: 1.25rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .meta { margin: 8px 0 0; font-size: 0.85rem; color: var(--cor-suave); }

  /* Ajustes por tamanho */
  [data-formato='pequeno'] .balao { display: none; }
  [data-formato='grande'] { padding: 28px; }
  [data-formato='grande'] h2 { font-size: clamp(1.6rem, 2.6vw, 2.3rem); }
  [data-formato='grande'] .balao { font-size: clamp(1.15rem, 1.8vw, 1.45rem); -webkit-line-clamp: 5; max-width: 80%; }
  [data-formato='alto'] .balao { -webkit-line-clamp: 7; }
  [data-formato='largo'] h2 { font-size: 1.5rem; -webkit-line-clamp: 2; }
  [data-formato='largo'] .balao { -webkit-line-clamp: 2; max-width: 75%; }
</style>
