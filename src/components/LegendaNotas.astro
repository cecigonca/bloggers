---
// Legenda das notas: uma régua de 1 a 5 (no celular vira lista).
// Abre por cima da página quando alguém clica em qualquer elemento com o atributo data-abrir-legenda.
import { notas } from '../lib/rotulos';

const escala = [...notas].sort((a, b) => Number(a.value) - Number(b.value));
---

<dialog id="legenda-notas" class="legenda" aria-labelledby="legenda-titulo">
  <div class="caixa">
    <button type="button" class="fechar" data-fechar-legenda aria-label="Fechar">×</button>
    <h2 id="legenda-titulo">Nossas notas</h2>

    <ol class="regua">
      {escala.map((n) => (
        <li class={`degrau nota-${n.value}`}>
          <span class="barra" aria-hidden="true"></span>
          <span class="numero" aria-label={`${n.value} estrela${n.value === '1' ? '' : 's'}`}>
            {n.value}
            <svg class="estrela" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor" />
            </svg>
          </span>
          <span class="textos">
            <strong>{n.label.toLowerCase()}</strong>
            <span class="frase">{n.descricao}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</dialog>

<script>
  const dialogo = document.getElementById('legenda-notas') as HTMLDialogElement;

  document.querySelectorAll('[data-abrir-legenda]').forEach((botao) =>
    botao.addEventListener('click', (evento) => {
      evento.preventDefault();
      dialogo.showModal();
    })
  );

  // Fecha no X ou clicando fora da caixa (a tecla Esc o navegador já resolve).
  dialogo.addEventListener('click', (evento) => {
    const alvo = evento.target as HTMLElement;
    if (alvo === dialogo || alvo.closest('[data-fechar-legenda]')) dialogo.close();
  });
</script>

<style>
  .legenda {
    border: 0;
    padding: 0;
    background: none;
    width: min(820px, calc(100% - 32px));
    max-height: calc(100% - 32px);
  }
  .legenda::backdrop { background: rgb(20 33 61 / 0.5); }
  .legenda[open] .caixa { animation: surgir 0.2s ease-out; }

  .caixa {
    position: relative;
    background: var(--branco);
    color: var(--texto);
    border-radius: 24px;
    padding: 36px 36px 40px;
  }
  h2 { font-size: 2rem; font-weight: 800; margin: 0 0 32px; }

  .fechar {
    position: absolute; top: 16px; right: 16px;
    width: 40px; height: 40px; border-radius: 50%;
    border: 0; background: var(--cinza-claro); color: var(--marinho);
    font-size: 1.5rem; line-height: 1; cursor: pointer;
  }
  .fechar:hover { background: var(--azul-cinza-claro); }

  /* Régua: cinco degraus lado a lado, a barra de cima vai do cinza ao marinho. */
  .regua {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }
  .degrau { display: flex; flex-direction: column; gap: 10px; }
  .barra { height: 10px; border-radius: 999px; background: var(--cor-degrau); }
  .nota-1 { --cor-degrau: var(--cinza-claro); }
  .nota-2 { --cor-degrau: var(--azul-cinza-claro); }
  .nota-3 { --cor-degrau: var(--azul-cinza); }
  .nota-4 { --cor-degrau: var(--marinho-claro); }
  .nota-5 { --cor-degrau: var(--dourado); }
  .nota-5 .estrela { color: var(--dourado); }

  .numero {
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: 4rem;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .estrela { width: 0.5em; height: 0.5em; flex: none; }
  .textos { display: flex; flex-direction: column; gap: 4px; padding-right: 8px; }
  strong { font-size: 1.05rem; font-weight: 700; }
  .frase { font-size: 0.92rem; line-height: 1.35; color: var(--texto-suave); }

  /* Celular: vira lista, um embaixo do outro, com a barrinha na lateral. */
  @media (max-width: 640px) {
    .caixa { padding: 28px 22px 26px; }
    h2 { font-size: 1.6rem; margin-bottom: 20px; }
    .regua { grid-template-columns: 1fr; gap: 16px; }
    .degrau { flex-direction: row; align-items: center; gap: 14px; }
    .barra { width: 6px; height: auto; align-self: stretch; }
    .numero { font-size: 2.6rem; margin: 0; width: 2.2ch; gap: 4px; }
  }

  @keyframes surgir { from { opacity: 0; transform: translateY(12px); } }
  @media (prefers-reduced-motion: reduce) { .legenda[open] .caixa { animation: none; } }
</style>
