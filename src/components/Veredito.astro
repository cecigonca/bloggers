---
// Selinho com a nota e o veredito: "4★ · aprovado".
import Estrela from './Estrela.astro';
import { veredito } from '../lib/rotulos';

interface Props {
  nota: number;
}

const { nota } = Astro.props;
const { label } = veredito(nota);
const tom = nota >= 4 ? 'alto' : nota === 3 ? 'medio' : 'baixo';
---

<span class:list={['selo', tom]} aria-label={`Nota ${nota} de 5: ${label}`}>
  <strong>{nota}<Estrela /></strong> · {label.toLowerCase()}
</span>

<style>
  .selo {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  strong { display: inline-flex; align-items: center; gap: 2px; }
  .alto { background: var(--marinho); color: var(--branco); }
  .medio { background: var(--azul-cinza); color: var(--branco); }
  .baixo { background: var(--branco); color: var(--marinho); box-shadow: inset 0 0 0 1.5px var(--marinho); }
</style>
