---
// Selinho com a nota e o veredito, tipo um adesivo: "4/5 · Aprovado".
import { veredito } from '../lib/rotulos';

interface Props {
  nota: number;
}

const { nota } = Astro.props;
const { label } = veredito(nota);
const tom = nota >= 4 ? 'alto' : nota === 3 ? 'medio' : 'baixo';
---

<span class:list={['selo', tom]}>
  <strong>{nota}/5</strong> · {label}
</span>

<style>
  .selo {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 6px 12px;
    border-radius: 999px;
    transform: rotate(-3deg);
    white-space: nowrap;
    box-shadow: 0 2px 0 rgb(20 33 61 / 0.15);
  }
  .alto { background: var(--marinho); color: var(--branco); }
  .medio { background: var(--azul-cinza); color: var(--branco); }
  .baixo { background: var(--branco); color: var(--marinho); border: 2px solid var(--marinho); }
</style>
