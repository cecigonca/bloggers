---
// Selinho com a nota e o veredito: "4★ · aprovado".
// Com `quem`, vira a versão curtinha usada quando as duas discordam: "C 4★".
import Estrela from './Estrela.astro';
import { veredito } from '../lib/rotulos';

interface Props {
  nota: number;
  quem?: string;
}

const { nota, quem } = Astro.props;
const { label } = veredito(nota);
const tom = nota === 5 ? 'ouro' : nota === 4 ? 'alto' : nota === 3 ? 'medio' : 'baixo';
const descricao = quem ? `${quem}: nota ${nota} de 5, ${label}` : `Nota ${nota} de 5: ${label}`;
---

<span class:list={['selo', tom]} aria-label={descricao}>
  {quem && <span class="quem">{quem.charAt(0)}</span>}
  <strong>{nota}<Estrela /></strong>
  {!quem && <> · {label.toLowerCase()}</>}
</span>

<style>
  .selo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 4px 12px 4px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  /* O número e a estrela ficam maiores que o nome, pra nota ser a primeira coisa que o olho lê. */
  strong {
    display: inline-flex; align-items: center; gap: 2px;
    font-family: var(--fonte-titulo); font-size: 1.5em; font-weight: 800;
    letter-spacing: 0; text-transform: none; line-height: 1;
  }
  .quem { font-weight: 800; opacity: 0.75; margin-right: 2px; }
  .ouro { background: var(--dourado); color: var(--branco); }
  .alto { background: var(--marinho); color: var(--branco); }
  .medio { background: var(--azul-cinza); color: var(--branco); }
  .baixo { background: var(--branco); color: var(--marinho); box-shadow: inset 0 0 0 1.5px var(--marinho); }
</style>
